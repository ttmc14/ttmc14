export-pad-not-anchored = Nothing happens. Secure the { $pad } to the floor first.
export-pad-no-power = A red light comes on. The { $pad } needs power.
export-pad-cooldown = The { $pad } is recharging. Time remaining: { $seconds } s.
export-pad-live-animal = Live creatures cannot be sold.
export-pad-human-not-interesting = High Command has no interest in this cargo.
export-pad-human-alive = The target is still alive and cannot be sold.
export-pad-sold =
    Cargo sold for { $points ->
        [one] { $points } point
       *[other] { $points } points
    }.
