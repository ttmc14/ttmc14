<ui:MCShuttleConsoleWindow xmlns="https://spacestation14.io"
                           xmlns:ui="clr-namespace:Content.Client._MC.Shuttle.Console.UI"
                           xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                           xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                           MinWidth="420" Title="{Loc mc-evac-title}">
    <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="6">
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#142226" BorderColor="#62B2AB" BorderThickness="4 0 0 0" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="16 12" SeparationOverride="6">
                <Label Text="{Loc mc-evac-status}" FontColorOverride="#8CCFC9" StyleClasses="LabelHeading" />
                <Label Name="Status" Access="Public" Text="{Loc mc-evac-status-offline}" />
            </BoxContainer>
        </PanelContainer>
        <Button Name="Launch" Access="Public" Text="{Loc mc-evac-launch}" Disabled="True" />
        <controls:ConfirmButton Name="EarlyLaunch" Access="Public" Text="{Loc mc-evac-early}"
                                ConfirmationText="{Loc mc-evac-confirm}" Visible="False" />
    </BoxContainer>
</ui:MCShuttleConsoleWindow>
