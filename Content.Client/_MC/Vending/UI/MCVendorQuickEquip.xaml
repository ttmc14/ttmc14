<ui:MCVendorQuickEquip xmlns="https://spacestation14.io"
                        xmlns:ui="clr-namespace:Content.Client._MC.Vending.UI"
                        xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                        MinSize="460 350"
                        Title="{Loc ent-MCMachineVendingQuickEquip}">
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <BoxContainer SeparationOverride="8">
            <Label Text="{Loc mc-quick-equip-preview}" StyleClasses="LabelHeading" HorizontalExpand="True" />
            <Button Name="ImportButton" Access="Public" Text="{Loc mc-quick-equip-open}" />
        </BoxContainer>
        <PanelContainer VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#171E24" BorderColor="#42505B" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <ScrollContainer Name="ListScroll" Visible="False" HScrollEnabled="False" Margin="8">
                <BoxContainer Name="Items" Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True" />
            </ScrollContainer>
            <BoxContainer Name="EmptyState" Orientation="Vertical" HorizontalAlignment="Center"
                          VerticalAlignment="Center" SeparationOverride="8">
                <TextureRect Name="VendorIcon" SetSize="64 64"
                             HorizontalAlignment="Center" Stretch="KeepAspectCentered" />
                <Label Name="EmptyHint" Text="{Loc mc-quick-equip-prompt}" Align="Center" StyleClasses="LabelSubText" />
            </BoxContainer>
        </PanelContainer>
        <Label Name="Status" Visible="False" />
        <BoxContainer SeparationOverride="8">
            <Button Name="ExportButton" Access="Public" Text="{Loc mc-quick-equip-save}" />
            <Control HorizontalExpand="True" />
            <Button Name="VendButton" Text="{Loc mc-quick-equip-vend}" StyleClasses="ButtonColorGreen" Disabled="True" />
        </BoxContainer>
    </BoxContainer>
</ui:MCVendorQuickEquip>
