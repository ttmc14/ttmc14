<ui:MCBeaconChooseWindow
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._MC.Beacon.UI"
    xmlns:map="clr-namespace:Content.Client._RMC14.TacticalMap"
    Title="{Loc mc-asrs-beacon-choice}"
    MinSize="760 460">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="8">
            <ItemList Name="BeaconList" SelectMode="Single" MinWidth="240" VerticalExpand="True" />
            <PanelContainer StyleClasses="BorderedWindowPanel" HorizontalExpand="True" VerticalExpand="True" RectClipContent="True">
                <map:TacticalMapControl Name="Map" MouseFilter="Stop" HorizontalExpand="True" VerticalExpand="True" />
                <Label Name="MapStatus" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </PanelContainer>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" Align="End" SeparationOverride="8">
            <Button Name="CancelButton" Text="{Loc quick-dialog-ui-cancel}" />
            <Button Name="SubmitButton" Text="{Loc generic-confirm}" Disabled="True" />
        </BoxContainer>
    </BoxContainer>
</ui:MCBeaconChooseWindow>
