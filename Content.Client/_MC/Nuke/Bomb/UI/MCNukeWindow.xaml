<ui:MCNukeWindow xmlns="https://spacestation14.io"
                 xmlns:ui="clr-namespace:Content.Client._MC.Nuke.Bomb.UI"
                 MinSize="410 260" Title="{Loc mc-nuke-title}">
    <BoxContainer Orientation="Vertical" Margin="8">
        <Label Name="StatusLabel" StyleClasses="LabelHeading" />
        <ProgressBar Name="TimeLeftProgressBar" MinValue="0" MaxValue="1" Margin="0 4">
            <Label Name="TimeLeftLabel" Align="Center" />
        </ProgressBar>
        <Button Name="TimerButton" Access="Public" Disabled="True" />
        <GridContainer Name="Settings" Columns="2" HSeparationOverride="10" Margin="0 8">
            <Label Text="{Loc mc-nuke-delay}" />
            <BoxContainer Name="TimeControls" />
            <Label Text="{Loc mc-nuke-safety}" />
            <Button Name="SafetyButton" Access="Public" />
            <Label Text="{Loc mc-nuke-anchor}" />
            <Button Name="AnchorButton" Access="Public" />
        </GridContainer>
        <Label Text="{Loc mc-nuke-disks}" StyleClasses="LabelHeading" />
        <GridContainer Name="Disks" Columns="2" HSeparationOverride="10" />
    </BoxContainer>
</ui:MCNukeWindow>
