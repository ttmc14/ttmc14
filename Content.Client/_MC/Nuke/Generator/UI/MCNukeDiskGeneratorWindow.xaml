<ui:MCNukeDiskGeneratorWindow xmlns="https://spacestation14.io"
                              xmlns:ui="clr-namespace:Content.Client._MC.Nuke.Generator.UI"
                              MinSize="410 140" Title="{Loc mc-nuke-generator-title}">
    <BoxContainer Orientation="Vertical" Margin="8">
        <Label Name="StatusLabel" />
        <ProgressBar Name="OverallProgressBar" MinValue="0" MaxValue="100" Margin="0 6">
            <Label Name="OverallProgressLabel" Align="Center" />
        </ProgressBar>
        <Button Name="RunButton" Disabled="True" Access="Public" />
    </BoxContainer>
</ui:MCNukeDiskGeneratorWindow>
